{
  "flex-layout.row#banner-inicial-novaHome": {
    "props": {
      "blockClass": "banner-inicial-novaHome",
      "fullWidth": true
    },
    "title": "Linha Banner Principal",
    "children": [
      "scheduled-image-list#home-banner-home"
    ]
  },
  "scheduled-image-list#home-banner-home": {
    "props": {
      "blocClass": "listContext-novahome",
      "images": [
        {
          "mobileImage": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/ad68f091-ca96-4fb2-b486-6427d80b9795___839a46697926e7675d00f9188b733942.png",
          "image": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/179ea8ef-137f-472e-8713-47059e50ae8b___28a06f8964603ab25f326db303e8eeb8.png",
          "link": {
            "url": "https://www.pensemadu.com.br/veterinaria/"
          },
          "startDate": "01/01/2026",
          "endDate": "31/12/2026"
        },
        {
          "mobileImage": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/98e241f0-9b91-4fbc-a80b-221842a0c7a5___3b6e85e8b91e16cb1103f963720a7319.png",
          "image": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/1cbe1119-19ce-42c5-a5f4-3a9ae9e71504___4270d6ec5847efb90f4abdcf8809f883.png",
          "link": {
            "url": "https://www.pensemadu.com.br/maduset/"
          },
          "startDate": "01/01/2026",
          "endDate": "31/12/2026"
        }
      ]
    },
    "children": [
      "slider-layout#home-novaHome"
    ]
  },
  "slider-layout#home-novaHome": {
    "props": {
      "title": "Slider home",
      "blockClass": "slider-novaHome",
      "maxwidth": "1200",
      "itemsPerPage": {
        "desktop": 1,
        "tablet": 1,
        "phone": 1
      },
      "arrowSize": 50,
      "infinite": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "never",
      "autoplay": {
        "timeout": 8000,
        "stopOnHover": true
      }
    }
  }
}
