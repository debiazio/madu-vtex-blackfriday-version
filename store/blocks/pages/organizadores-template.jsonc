{
  "store.custom#organizadores-template-menu": {
    "blocks": [
      "faq-structureddata-organizadores",
      "flex-layout.row#template-organizadores-linha-2",
      "controllervisualization"
    ]
  },
  "flex-layout.row#template-organizadores-linha-2": {
    "props": {
      "blockClass": "template-copy-linha-2"
    },
    "children": [
      "search-result-layout.customQuery#template-organizadores-cat"
    ]
  },
  "search-result-layout.customQuery#template-organizadores-cat": {
    "props": {
      "querySchema": {
        "orderByField": "OrderByTopSaleDESC",
        "hideUnavailableItems": true,
        "maxItemsPerPage": 9,
        "queryField": "25",
        "mapField": "c"
      }
    },
    "blocks": [
      "search-result-layout.desktop#template-organizadores"
    ]
  },
  "search-result-layout.desktop#template-organizadores": {
    "props": {
      "pagination": "infinite-scroll",
      "preventRouteChange": true,
      "showFacetQuantity": true,
      "blockClass": "busca-desktop",
      "defaultGalleryLayout": "grid"
    },
    "children": [
      "breadcrumb.search",
      // "search-title.v2",
      "flex-layout.row#results#template-organizadores-cat"
    ]
  },
  "flex-layout.row#results#template-organizadores-cat": {
    "props": {
      "blockClass": "plp-page",
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.col#filter-template-organizadores",
      "flex-layout.col#search-template-organizadores"
    ]
  },
  "flex-layout.col#filter-template-organizadores": {
    "props": {
      "width": "20%",
      "blockClass": [
        "filterCol",
        "filter-col-template"
      ],
      "verticalAlign": "top"
    },
    "children": [
      "filter-navigator.v3"
    ]
  },
  "flex-layout.col#search-template-organizadores": {
    "props": {
      "blockClass": "linha-template-search-container"
    },
    "children": [
      "search-content",
      "flex-layout.row#fetchmore"
    ]
  },
  "search-content": {
    "blocks": [
      "gallery",
      "not-found"
    ]
  },
  "gallery": {
    "props": {
      "layouts": [
        {
          "name": "grid",
          "component": "GridSummary",
          "itemsPerRow": {
            "(min-width:1300px)": 3,
            "desktop": 3,
            "tablet": 2,
            "phone": 2
          }
        }
      ],
      "GridSummary": "product-summary.shelf"
    }
  }
}
