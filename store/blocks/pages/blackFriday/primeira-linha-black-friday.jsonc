{
  "responsive-layout.desktop#banner-blackf": {
    "children": [
      "flex-layout.row#primeira-linha-blackFriday"
    ]
  },
  "responsive-layout.mobile#banner-blackf": {
    "children": [
      "flex-layout.row#mobile-primeira-linha-blackFriday"
    ]
  },
  "flex-layout.row#primeira-linha-blackFriday": {
    "props": {
      "blockClass": "primeira-linha-black-friday",
      "preventHorizontalStretch": true,
      "colSizing": "auto"
    },
    "children": [
      "image#banner-blackfriday"
    ],
    "title": "Banner inicial"
  },
  "image#banner-blackfriday": {
    "props": {
      "blockClass": "banner-blackfriday",
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/8c89deda-2568-4764-b783-a2e7d8a4a309___4778a1a42ed85be15378b210ccbe856f.webp"
    }
  },
  // mobile
  "flex-layout.row#mobile-primeira-linha-blackFriday": {
    "children": [
      "image#banner-mobile-blackfriday"
    ]
  },
  "image#banner-mobile-blackfriday": {
    "props": {
      "blockClass": "banner-blackfriday",
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/258d3dad-d53b-4bfe-87ea-c3fbdc2e920e___807677a6eddb21e32a5b75b412f489ff.webp"
    }
  }
}
