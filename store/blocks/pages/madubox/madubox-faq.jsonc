{
  "flex-layout.row#linhaFAQs-madubox": {
    "props": {
      "blockClass": "linhaFAQs-madubox",
      "fullWidth": true
    },
    "children": [
      "flex-layout.row#textos-faq-madubox",
      "flex-layout.row#disclosure-faq-madubox"
    ]
  },
  "flex-layout.row#textos-faq-madubox": {
    "props": {
      "blockClass": "textos-faq-maduset"
    },
    "children": [
      "rich-text#tituloFAQs-madubox",
      "rich-text#subTituloFAQs-madubox"
    ]
  },
  "rich-text#tituloFAQs-madubox": {
    "props": {
      "blockClass": "titulo-kitsprontos-maduset",
      "text": "### FAQ",
      "textAlignment": "CENTER",
      "textPosition": "CENTER"
    }
  },
  "rich-text#subTituloFAQs-madubox": {
    "props": {
      "blockClass": "subtitulo-kitsprontos-maduset",
      "text": "Perguntas frequentes",
      "textAlignment": "CENTER",
      "textPosition": "CENTER"
    }
  },
  "flex-layout.row#disclosure-faq-madubox": {
    "props": {
      "blockClass": "disclosure-faq-maduset",
      "colSizing": "auto"
    },
    "children": [
      "disclosure-layout-group#faq-madubox"
    ]
  },
  "disclosure-layout-group#faq-madubox": {
    "props": {
      "blockClass": "group-faq-maduset"
    },
    "children": [
      "disclosure-layout#oqEhMadubox-madubox",
      "disclosure-layout#paraQuaisSegmentos-madubox",
      "disclosure-layout#beneficiosPrincipais-madubox",
      "disclosure-layout#podeSerPersonalizada-madubox",
      "disclosure-layout#compativelCarrinhosGavetas-madubox",
      "disclosure-layout#identificacaoPorCores-madubox",
      "disclosure-layout#possuiPatente-madubox",
      "disclosure-layout#modulosSubstituidosReorganizados-madubox",
      "disclosure-layout#materialFabricacao-madubox",
      "disclosure-layout#limpezaOrganizadores-madubox",
      "disclosure-layout#solicitarOrcamento-madubox",
      "disclosure-layout#atendimentoBrasil-madubox",
      "disclosure-layout#trocaPlacaEmbalagem-madubox"
    ]
  },

  // O que é
  "disclosure-layout#oqEhMadubox-madubox": {
    "props": {
      "blockClass": "layout-faq-maduset"
    },
    "children": [
      "disclosure-trigger#oqEhMadubox-madubox",
      "disclosure-content#oqEhMadubox-madubox"
    ]
  },
  "disclosure-trigger#oqEhMadubox-madubox": {
    "props": {
      "blockClass": "trigger-faq-maduset"
    },
    "children": [
      "rich-text#trigger-oqEhMadubox-madubox",
      "disclosure-state-indicator#configSet-maduset"
    ]
  },
  "rich-text#trigger-oqEhMadubox-madubox": {
    "props": {
      "blockClass": "text-trigger-faq-madu",
      "text": "### O que é a MAD.U BOX?"
    }
  },
  "disclosure-content#oqEhMadubox-madubox": {
    "props": {
      "blockClass": "content-faq-maduset"
    },
    "children": [
      "rich-text#content-oqEhMadubox-madubox"
    ]
  },
  "rich-text#content-oqEhMadubox-madubox": {
    "props": {
      "blockClass": "content-faq-maduset",
      "text": "#### A MAD.U BOX é uma solução inteligente para organização, identificação e armazenamento de medicamentos, insumos e materiais. Seu sistema modular permite personalizar a organização conforme a necessidade de cada ambiente, proporcionando mais praticidade, segurança e agilidade na rotina."
    }
  },

  // Para quais segmentos
  "disclosure-layout#paraQuaisSegmentos-madubox": {
    "props": {
      "blockClass": "layout-faq-maduset"
    },
    "children": [
      "disclosure-trigger#paraQuaisSegmentos-madubox",
      "disclosure-content#paraQuaisSegmentos-madubox"
    ]
  },
  "disclosure-trigger#paraQuaisSegmentos-madubox": {
    "props": {
      "blockClass": "trigger-faq-maduset"
    },
    "children": [
      "rich-text#trigger-paraQuaisSegmentos-madubox",
      "disclosure-state-indicator#configSet-maduset"
    ]
  },
  "rich-text#trigger-paraQuaisSegmentos-madubox": {
    "props": {
      "blockClass": "text-trigger-faq-madu",
      "text": "### Para quais segmentos a MAD.U BOX é indicada?"
    }
  },
  "disclosure-content#paraQuaisSegmentos-madubox": {
    "props": {
      "blockClass": "content-faq-maduset"
    },
    "children": [
      "rich-text#content-paraQuaisSegmentos-madubox"
    ]
  },
  "rich-text#content-paraQuaisSegmentos-madubox": {
    "props": {
      "blockClass": "content-faq-maduset",
      "text": "#### A MAD.U BOX pode ser utilizada em hospitais, clínicas, consultórios, laboratórios, farmácias, centros de estética, veterinárias, home care e diversos ambientes que necessitam de organização eficiente de medicamentos e materiais."
    }
  },

  // FAQ - Benefícios da MAD.U BOX
  "disclosure-layout#beneficiosPrincipais-madubox": {
    "props": {
      "blockClass": "layout-faq-maduset"
    },
    "children": [
      "disclosure-trigger#beneficiosPrincipais-madubox",
      "disclosure-content#beneficiosPrincipais-madubox"
