{
  "flex-layout.row#variacoesAltura-madubox": {
    "props": {
      "blockClass": "linha-variacoesAltura-madubox",
      "fullWidth": true
    },
    "children": [
      "rich-text#titulo-varAltura-madubox",
      "flex-layout.row#imagens-varAltura-madubox"
    ]
  },
  "rich-text#titulo-varAltura-madubox": {
    "props": {
      "blockClass": "tituloVarAltura-madubox",
      "text": "todos os tamanhos possuem \n **variações de alturas:**",
      "textAlignment": "LEFT",
      "textPosition": "LEFT"
    }
  },
  "flex-layout.row#imagens-varAltura-madubox":{
    "props": {
      "blockClass": "linha-imagens-varAltura-madubox",
      "colSizing": "auto",
      "preventHorizontalStretch": true
    },
    "children": [
      "image#tamanhoP-varAlt-madubox",
      "image#tamanhoM-varAlt-madubox",
      "image#tamanhoG-varAlt-madubox",
      "image#tamanhoGG-varAlt-madubox"
    ]
  },
        "image#tamanhoP-varAlt-madubox":{
          "props": {
            "blockClass": "imgs-varAlt",
            "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/6ad1e004-1ce7-4766-a3d0-2af61fec9b84___2be74fbb7e24c3da0ab8786f77128781.webp"
          }
        },
      "image#tamanhoM-varAlt-madubox":{
        "props": {
          "blockClass": "imgs-varAlt",
          "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/fa3a3102-1ede-45d0-89c4-2061ed37ca6f___4674c3b5458569ef05432b07e89db1f9.webp"
        }
      },
