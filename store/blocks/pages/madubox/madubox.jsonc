{
  "store.custom#madubox": {
    "blocks": [
      "responsive-layout.desktop#imagem-banner-box",
      "responsive-layout.mobile#imagem-banner-box",
      "flex-layout.row#linhaBox-estruturas-madubox",
      "flex-layout.row#linhaDuasOpcoes-madubox",
      "flex-layout.row#escolha-tamanho-dieal-madubox",
      "responsive-layout.desktop#escolha-tamanho-ideal2-madubox",
      "responsive-layout.mobile#escolha-tamanho-ideal2-madubox",
      "flex-layout.row#desorganizacao-madubox",
      "flex-layout.row#variacoesAltura-madubox",
      "responsive-layout.mobile#solucoes-combinadas-madubox",
      "responsive-layout.desktop#solucoes-combinadas-madubox",
      "flex-layout.row#desorganizacao-2-madubox"
      //  "flex-layout.row#linhaFAQs-madubox"
    ]
  },


  // BANNER FINAL
  "flex-layout.row#desktop-banner-final": {
    "props": {
      "blockClass": "banner-final-madu-box",
      "colSizing": "auto",
      "preventVerticalStretch": true
    },
    "children": [
      "rich-text#texto-banner-final",
      "link#fale-especialista"
    ]
  },
  // TEXTO BANNER FINAL
  "rich-text#texto-banner-final": {
    "props": {
      "blockClass": "texto-banner-final-madubox",
      "text": "adquira a sua\nMadu Box\n agora mesmo. "
    }
  },
  // LINK FALE COM
  "link#fale-especialista": {
    "props": {
      "href": "https://api.whatsapp.com/send?phone=5541996878783&text=Ol%C3%A1%2C%20estou%20vindo%20do%20site%20da%20MAD.U!",
      "label": "Falar com consultora",
      "blockClass": "link-banner-final-madubox"
    }
  }
}
