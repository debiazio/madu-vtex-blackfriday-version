  },
  "rich-text#titulo-cx-org1-odonto": {
    "props": {
      "blockClass": "titulo-cx-org-odonto",
      "text": "**Caixa Organizadora Multiuso** \n Antimicrobiana para Instrumentos Odontológicos",
      "textAlignment": "CENTER",
      "textPosition": "CENTER"
    }
  },
