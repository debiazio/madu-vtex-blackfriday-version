    }
  },
  "rich-text#subtitulo-cx-org1-odonto": {
    "props": {
      "blockClass": "subtitulo-cx-org1-odonto",
      "text": "Formato compacto que aproveita gavetas, armários, bancadas e estantes. Ideal pra organizar pequenos materiais, acessórios e componentes do dia a dia no consultório odontológico.",
      "textAlignment": "CENTER",
      "textPosition": "CENTER"
    }
  },
  "rich-text#atributos-cx-org1-odonto": {
    "props": {
      "blockClass": "subtitulo-cx-org1-odonto",
      "text": "✓ Ação antimicrobiana \n ✓ Empilhável  | ocupa menos espaço \n  ✓ Fácil higienização",
      "textAlignment": "CENTER",
      "textPosition": "CENTER"
    }
  },
  "link#ver-produto1-org-odonto": {
