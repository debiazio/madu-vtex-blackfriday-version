    ]
  },
  "rich-text#titulo-produto2-monteSeuJeito-odonto": {
    "props": {
      "blockClass": "titulo-monteSeujeito-odonto",
      "text": "**Maleta de Sedação EASY LOCK** \n MAD.U BOX"
    }
  },
  "rich-text#preco-produto2-monteSeuJeito-odonto": {
    "props": {
      "blockClass": "textos-monteSeujeito-odonto",
      "text": "De R$ 655,90 \n **Por R$ 479,90 | 10x de R$ 47,99**"
    }
  },
  "rich-text#descritivos-produto2-monteSeuJeito-odonto": {
    "props": {
      "blockClass": "textos-monteSeujeito-odonto",
      "text": "✓ MAD.U SET com 16 peças OPEN SET \n ✓ Fechamento Easy Lock \n ✓ Módulos organizadores coloridos"
