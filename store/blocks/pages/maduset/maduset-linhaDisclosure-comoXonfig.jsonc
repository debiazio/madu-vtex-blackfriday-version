      "disclosure-content#coresSet-maduset"
    ]
  },
  "disclosure-trigger#coresSet-maduset": {
    "props": {
      "blockClass": "trigger-comoConfig-maduset"
    },
    "children": [
      "rich-text#trigger-coresSet-maduset",
      "disclosure-state-indicator#configSet-maduset"
    ]
  },
  "disclosure-content#coresSet-maduset": {
    "props": {
      "blockClass": [
        "content-comoConfig-maduset",
        "grid-coresSet-maduset"
      ]
    },
    "children": [
      "flex-layout.col#branco-maduset",
      "flex-layout.col#cinza-maduset",
      "flex-layout.col#preto-maduset",
      "flex-layout.col#azul-maduset",
      "flex-layout.col#verde-maduset",
      "flex-layout.col#amarelo-maduset",
      "flex-layout.col#laranja-maduset",
      "flex-layout.col#vermelho-maduset",
      "flex-layout.col#lilas-maduset",
      "flex-layout.col#azul-listras-maduset",
      "flex-layout.col#laranja-listras-maduset",
      "flex-layout.col#lilas-listras-maduset"
    ]
  },
  "rich-text#trigger-coresSet-maduset": {
    "props": {
      "blockClass": "texto-trigger-comoConfig-maduset",
      "text": "**3** Escolha as cores de seu open set"
    }
  },
