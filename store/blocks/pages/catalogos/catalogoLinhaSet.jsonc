{
  "flex-layout.col#catalogo-linha-set": {
    "props": {
      "blockClass": "linhasCatalogos",
      "colSizing": "auto",
      "preventVerticalStretch": true
    },
    "children": [
      "image#capacatalogo-set",
      "rich-text#titulo-set",
      "link#lerCatalogo-set",
      "btn-linha-set"
    ]
  },
  "image#capacatalogo-set": {
    "props": {
      "blockClass": "capaCatalogo",
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/038cf6c3-399c-4e15-afda-46c0114e2255___063d211dd5059a74b8439df38ed4bba3.webp",
      "alt": "capa catálogo"
    }
  },
  "rich-text#titulo-set": {
    "props": {
      "blockClass": "titulo-catalogo",
      "text": "Linha Set",
      "textPosition": "CENTER",
      "textAlignment": "CENTER"
    }
  },
  "link#lerCatalogo-set": {
    "props": {
      "blockClass": "linkLerCatalogo",
      "label": "Ler catálogo",
      "href": "https://stermax.com.br/images_idealine/catalogosMadu/LA_MADU_Folder-SET_Digital.pdf",
      "target": "_blank"
    }
  }
}
