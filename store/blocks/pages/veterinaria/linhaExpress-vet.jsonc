      "label": "Ver Produto",
      "productName": "Bancada Profissional em Inox com 24 Bins Antimicrobianos e 3 Big Bins | MAD.U Express",
      "productLine": "express",
      "ctaType": "ver_produto",
      "productPosition": 4,
      "pageName": "lp_veterinaria"
    },
    "title": "Link ver produto"
  },
  "componente-link-consultor#falarVendedor-linhaExpress-vet": {
