    ]
  },
  "link#verProduto-carrinho-vet": {
    "props": {
      "blockClass": "link-verProduto",
      "href": "https://www.pensemadu.com.br/carrinho-auxiliar-inox-big-bin-madu-express/p",
      "label": "ver produto"
    },
    "title": "Link ver produto carrinho"
  },
  "link#falarVendedor-carrinho-vet": {
    "props": {
      "blockClass": "link-falarConsultor-vet",
      "href": "https://wa.me/5541996878783?text=Ol%C3%A1%2C%20estou%20vindo%20da%20p%C3%A1gina%20de%20Veterin%C3%A1ria%20e%20quero%20mais%20informa%C3%A7%C3%B5es%20sobre%20o%20Carrinho%20Express%20com%20Tampo%20Inox%20e%20Big%20Bin",
      "label": "falar com consultor",
