      "blockClass": "titulo-subcoluna-produto-linhaExpress-vet",
      "text": "Carrinho Express com Tampo Inox e Big Bin",
      "textAlignment": "CENTER",
      "textPosition": "CENTER"
    }
  },
  "flex-layout.row#links-carrinho-subcoluna-linhaExpress-vet": {
