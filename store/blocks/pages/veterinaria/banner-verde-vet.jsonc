{
  "flex-layout.row#banner-verde-vet": {
    "title": "Banner verde",
    "props": {
      "blockClass": "linha-bannerVerde-vet",
      "fullWidth": true
    },
    "children": [
      "flex-layout.row#textosLink-banner-verde-vet",
      "image#doguinho-bannerVerde-vet"
    ]
  },
  // ====================================================
  // linha textos
  // ====================================================
  "flex-layout.row#textosLink-banner-verde-vet": {
    "title": "Linha textos e link banner verde",
    "props": {
      "blockClass": "linha-textos-banner-verde-vet",
      "preventHorizontalStretch": true
    },
    "children": [
      "flex-layout.row#textos-bannerVerde-vet",
      "flex-layout.row#links-bannerVerde-vet"
    ]
  },
  "flex-layout.row#textos-bannerVerde-vet": {
    "title": "Linha textos banner verde",
    "props": {
      "blockClass": "linha-textos-bannerVerde-vet",
      "preventHorizontalStretch": true
    },
    "children": [
      "rich-text#titulo-bannerVerde-vet",
      "rich-text#subtitulo-bannerVerde-vet"
    ]
  },
  "rich-text#titulo-bannerVerde-vet": {
    "title": "Titulo banner verde",
    "props": {
      "blockClass": "titulo-bannerVerde-vet",
      "text": "### Encontre a configuração \n ### **ideal para sua rotina**"
    }
  },
  "rich-text#subtitulo-bannerVerde-vet": {
    "title": "subtitulo-bannerVerde-vet",
    "props": {
      "blockClass": "subtitulo-bannerVerde-vet",
      "text": "Com o apoio de um consultor MAD.U, você pode avaliar módulos, acessórios e configurações compatíveis com cada produto e com as necessidades da sua operação veterinária."
    }
  },
  "flex-layout.row#links-bannerVerde-vet": {
    "title": "Links banner verde",
    "props": {
      "blockClass": "linha-links-bannerVerde-vet",
      "preventHorizontalStretch": true,
      "colSizing": "auto"
    },
    "children": [
      "componente-link-custom#verProduto-vet",
      "componente-link-consultor#falarVendedor-vet"
    ]
  },
  "componente-link-custom#verProduto-vet": {
    "props": {
      "blockClass": "link-verProduto",
      "href": "https://www.pensemadu.com.br/mobiliario-veterinario",
      "label": "Ver Produto",
      "productName": "todos_produtos_veterinaria",
      "productLine": "todos",
      "ctaType": "ver_produto",
      "productPosition": 8,
      "pageName": "lp_veterinaria"
    },
    "title": "Link ver produto"
  },
  "componente-link-consultor#falarVendedor-vet": {
    "props": {
      "href": "https://api.whatsapp.com/send/?phone=5541996878783&text=Ol%C3%A1%2C+estou+vindo+da+p%C3%A1gina+de+Veterin%C3%A1ria+e+quero+ajuda+para+encontrar+a+configura%C3%A7%C3%A3o+ideal+para+minha+rotina&type=phone_number&app_absent=0",
      "label": "Falar com Consultor",
      "productName": "todos_produtos_veterinaria",
      "productLine": "todos",
      "ctaType": "falar_com_consultor",
      "productPosition": 8,
      "pageName": "lp_veterinaria"
    },
    "title": "Link falar com consultor"
  },
  // ====================================================
  // linha imagem
  // ====================================================
  "image#doguinho-bannerVerde-vet": {
    "title": "Imagem cachorrinho banner verde",
    "props": {
      "blockClass": "doguinho-bannerVerde-vet",
      "alt": "cachorrinho",
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/b8c6b297-1312-4e62-90d2-a708a60d3e81___499696a69f1d1d0e5c2ffee75db6ad27.webp"
    }
  }
}
