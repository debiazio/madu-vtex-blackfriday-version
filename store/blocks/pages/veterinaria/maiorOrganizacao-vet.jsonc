{
  "flex-layout.row#maiorOrganizacao-vet": {
    "props": {
      "blockClass": "linha-maiorOrganizacao-vet",
      "fullWidth": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "flex-layout.row#textos-maiorOrg-vet",
      "responsive-layout.desktop#img-maiorOrg-vet",
      "responsive-layout.mobile#img-maiorOrg-vet",
      "flex-layout.row#links-maiorOrg-vet"
    ],
    "title": "Linha maior organização"
  },
  "flex-layout.row#textos-maiorOrg-vet": {
    "props": {
      "blockClass": "textos-maiorOrg-vet"
    },
    "children": [
      "rich-text#titulo-maiorOrg-vet",
      "rich-text#subtitulo-maiorOrg-vet"
    ],
    "title": "Linha textos maior organização"
  },
  "rich-text#titulo-maiorOrg-vet": {
    "props": {
      "text": "## BINS PARA ORGANIZAR A ROTINA VETERINÁRIA",
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "blockClass": "titulo-maiorOrg-vet"
    },
    "title": "Titulo maior organização"
  },
  "rich-text#subtitulo-maiorOrg-vet": {
    "props": {
      "text": "Bins antimicrobianos com tampa para separar medicamentos, insumos e pequenos materiais, facilitando a identificação e o acesso durante atendimentos, curativos, coletas e internações.",
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "blockClass": "titulo-maiorOrg-vet"
    },
    "title": "Subitulo maior organização"
  },
  // ----------------------
  // imagem mobile
  // ----------------------
  "responsive-layout.mobile#img-maiorOrg-vet": {
    "children": [
      "flex-layout.row#mobile-img-maiorOrg-vet"
    ],
    "title": "Mobile - img maior organização"
  },
  "flex-layout.row#mobile-img-maiorOrg-vet": {
    "props": {
      "blockClass": "linha-img-maiorOrg-vet"
    },
    "children": [
      "image#mobile-img-maiorOrg-vet"
    ],
    "title": "Mobile -Linha img maior organização"
  },
  "image#mobile-img-maiorOrg-vet": {
    "props": {
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/fe4858ac-34f4-4747-a440-86615decb9ee___937bf73c74e29b16388c19f02c20a701.webp",
      "alt": "Imagem maior organização",
      "blockClass": "img-maiorOrg-vet"
    },
    "title": "Imagem maior organização - mobile"
  },
  // ----------------------
  // imagem desktop
  // ----------------------
  "responsive-layout.desktop#img-maiorOrg-vet": {
    "children": [
      "flex-layout.row#img-maiorOrg-vet"
    ],
    "title": "Desktop - img maior organização"
  },
  "flex-layout.row#img-maiorOrg-vet": {
    "props": {
      "blockClass": "linha-img-maiorOrg-vet"
    },
    "children": [
      "image#img-maiorOrg-vet"
    ]
  },
  "image#img-maiorOrg-vet": {
    "props": {
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/e38eaebc-dd1d-4189-83ad-ee3a8a77dd01___3af91b4f6a58f95bda4e242f4d697c19.webp",
      "alt": "Imagem maior organização",
      "blockClass": "img-maiorOrg-vet"
    },
    "title": "Imagem maior organização"
  },
  // ====================
  // links
  "flex-layout.row#links-maiorOrg-vet": {
    "props": {
      "preventHorizontalStretch": true,
      "blockClass": [
        "links-estanteVet",
        "links-maiorOrg-vet"
      ]
    },
    "children": [
      "link#verproduto-maiorOrg-vet",
      "link#falarVendedor-maiorOrg-vet"
    ],
    "title": "Linha links maior organização"
  },
  "link#verproduto-maiorOrg-vet": {
    "props": {
      "blockClass": "link-verProduto",
      "href": "https://www.pensemadu.com.br/gaveteiro-plastico-antimicrobiano-numero-4-tampa-madu-one/p",
      "label": "ver produto"
    },
    "title": "Link ver produto"
  },
  "link#falarVendedor-maiorOrg-vet": {
    "props": {
      "blockClass": "link-falarConsultor-vet",
      "href": "#",
      "label": "falar com consultor"
    },
    "title": "Link falar com consultor"
  }
}
