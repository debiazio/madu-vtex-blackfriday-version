{
  "flex-layout.row#linhaOne-vet": {
    "props": {
      "blockClass": "linhas-vet",
      "fullWidth": true,
      "htmlId": "linhaone"
    },
    "children": [
      "flex-layout.col#titulo-linhaOne-vet",
      "flex-layout.col#img-linhaOne-vet",
      "flex-layout.col#produto-linhaOne-vet"
    ]
  },
  // coluna titulo one
  "flex-layout.col#titulo-linhaOne-vet": {
    "props": {
      "blockClass": "coluna-linhaOne-Vet"
    },
    "children": [
      "rich-text#titulo-linhaOne-vet"
    ]
  },
  "rich-text#titulo-linhaOne-vet": {
    "props": {
      "blockClass": "titulo-linhaOne-vet",
      "text": "## Um carrinho \n ## preparado para \n ## apoiar \n ##  **atendimentos,** \n ## **procedimentos** \n ## **e emergências.**"
    }
  },
  // img one
  "flex-layout.col#img-linhaOne-vet": {
    "props": {
      "blockClass": "col-img-OneVet"
    },
    "children": [
      "image#img-linhaOne-Vet"
    ]
  },
  "image#img-linhaOne-Vet": {
    "props": {
      "blockClass": "img-linhaOne-vet",
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/d33c8c18-d6cd-4325-a288-3c0da01459b6___957e7ad4e0296da1dba30e11d57879da.webp",
      "alt": "Linha one"
    }
  },
  // produto
  "flex-layout.col#produto-linhaOne-vet": {
    "props": {
      "blockClass": "produto-linhaOne-Vet",
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#linha-titulo-produtoLinhaOne-vet",
      "rich-text#titulo-produtoLinhaOne-vet",
      "rich-text#subtitulo-produtoLinhaOne-vet",
      "flex-layout.row#imagens-produtos-LinhaOne-vet",
      "flex-layout.row#links-produto-linhaOne-vet"
    ]
  },
  "flex-layout.row#linha-titulo-produtoLinhaOne-vet": {
    "props": {
      "blockClass": "linha-titulo-produtoLinhaOne-vet",
      "preventHorizontalStretch": true,
      "colSizing": "auto"
    },
    "children": [
      "rich-text#linha",
      "image#tag-one-vet"
    ]
  },
  "image#tag-one-vet": {
    "props": {
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/1cbdf2eb-1758-4f7a-9759-9181c687f8e0___213cf17ba35421a3655f03a4ce40ded1.svg",
      "blockClass": "image-tag-vet"
    }
  },
  "rich-text#linha": {
    "props": {
      "text": "Linha",
      "blockClass": "linha"
    },
    "title": "Linha"
  },
  "rich-text#titulo-produtoLinhaOne-vet": {
    "props": {
      "blockClass": "titulo-produtoLinhaOne-vet",
      "text": "Carrinho de Emergência \n Veterinária MAD.U ONE 560"
    }
  },
  "rich-text#subtitulo-produtoLinhaOne-vet": {
    "props": {
      "blockClass": "subtitulo-produtoLinhaOne-vet",
      "text": "O ONE 560 reúne quatro gavetas, acessórios técnicos, mobilidade e tecnologia antimicrobiana em uma configuração completa para atendimentos, procedimentos e emergências veterinárias."
    }
  },
  "flex-layout.row#imagens-produtos-LinhaOne-vet": {
    "props": {
      "blockClass": "imagens-produtos-LinhaOne-vet",
      "preventHorizontalStretch": true,
      "colSizing": "auto"
    },
    "children": [
      "image#lixeira-linhaOne-vet",
      "image#gavetas-linhaOne-vet",
      "image#lateral-linhaOne-vet"
    ]
  },
  "image#lixeira-linhaOne-vet": {
    "props": {
      "blockClass": "img-rectangulo-vet",
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/b621d220-35d6-4f91-93e3-427cb0fa1687___c202f0092a6a5f85db63ce86ceffbc60.webp"
    }
  },
  "image#gavetas-linhaOne-vet": {
    "props": {
      "blockClass": "img-rectangulo-vet",
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/60ca5621-48f3-42ce-87ff-724dbd9ef185___395d69e45096c2de9fae790a114557ce.webp"
    }
  },
  "image#lateral-linhaOne-vet": {
    "props": {
      "blockClass": "img-rectangulo-vet",
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/ee4b5f07-8851-46b7-b0cd-b20f9d835517___b62ca65207fa186131aea82af7fc3087.webp"
    }
  },
  "flex-layout.row#links-produto-linhaOne-vet": {
    "props": {
      "blockClass": "links-produto-linhaOne-vet",
      "preventHorizontalStretch": true
    },
    "children": [
      "link#verproduto-linhaOne-vet",
      "link#falarVendedor-linhaOne-vet"
    ],
    "title": "Links produto linha one"
  },
  "link#verproduto-linhaOne-vet": {
    "props": {
      "blockClass": "link-verProduto",
      "href": "https://www.pensemadu.com.br/carrinho-emergencia-hospitalar-4-gavetas-madu-one-560/p",
      "label": "ver produto"
    },
    "title": "Link ver produto"
  },
  "link#falarVendedor-linhaOne-vet": {
    "props": {
      "blockClass": "link-falarConsultor-vet",
      "href": "https://wa.me/5541996878783?text=Ol%C3%A1%2C%20estou%20vindo%20da%20p%C3%A1gina%20de%20Veterin%C3%A1ria%20e%20quero%20mais%20informa%C3%A7%C3%B5es%20sobre%20o%20Carrinho%20de%20Emerg%C3%AAncia%20Veterin%C3%A1ria%20MAD.U%20ONE%20560",
      "label": "falar com consultor",
      "target": "_blank"
    },
    "title": "Link falar com consultor"
  }
}
