{
  "flex-layout.row#banner-laranja-vet":{
    "title": "Banner laranja",
    "props": {
      "blockClass": "linha-bannerLaranja-vet",
      "fullWidth": true
    },
    "children": [
      "flex-layout.row#textosLink-banner-laranja-vet",
      "image#doguinho-bannerLaranja-vet"
    ]
  },
  // ====================================================
  // linha textos
  // ====================================================
  "flex-layout.row#textosLink-banner-laranja-vet":{
    "title": "Linha textos e link banner laranja",
    "props": {
      "blockClass": "linha-textos-banner-verde-vet",
      "preventHorizontalStretch": true
    },
    "children": [
      "flex-layout.row#textos-bannerLaranja-vet",
      "flex-layout.row#links-bannerLaranja-vet"
    ]
  },
  "flex-layout.row#textos-bannerLaranja-vet":{
    "title": "Linha textos banner laranja",
    "props": {
      "blockClass": "linha-textos-bannerVerde-vet",
      "preventHorizontalStretch": true
    },
    "children": [
      "rich-text#titulo-bannerLaranja-vet",
      "rich-text#subtitulo-bannerLaranja-vet"
    ]
  },
  "rich-text#titulo-bannerLaranja-vet":{
    "title": "Titulo banner laranja",
    "props": {
      "blockClass": "titulo-bannerLaranja-vet",
      "text": "### Sua clínica merece um \n ### mobiliário à altura da \n ### excelência do seu \n ### atendimento."
    }
  },
  "rich-text#subtitulo-bannerLaranja-vet":{
    "title": "subtitulo-bannerLaranja-vet",
    "props": {
      "blockClass": "subtitulo-bannerLaranja-vet",
      "text": "Converse com um especialista MAD.U e descubra como equipar seus ambientes com soluções técnicas, funcionais e de alto padrão."
    }
  },
  "flex-layout.row#links-bannerLaranja-vet":{
    "title": "Links banner laranja",
    "props": {
      "blockClass": "linha-links-bannerVerde-vet",
      "preventHorizontalStretch": true,
      "colSizing": "auto"
    },
    "children": [
      "link#falarVendedor-bannerLaranja-vet"
    ]
  },

  "link#falarVendedor-bannerLaranja-vet":{
    "title": "Link falar com vendedor bannerLaranja-vet",
    "props": {
      "blockClass": "falarVendedor-bannerLaranja-vet",
      "href": "https://wa.me/5541996878783?text=Ol%C3%A1%2C%20estou%20vindo%20da%20p%C3%A1gina%20de%20Veterin%C3%A1ria%20e%20quero%20descobrir%20como%20equipar%20meus%20ambientes%20com%20solu%C3%A7%C3%B5es%20t%C3%A9cnicas%2C%20funcionais%20e%20de%20alto%20padr%C3%A3o",
      "label": "Solicitar atendimento",
      "target": "_blank"
    }
  },
    // ====================================================
  // linha imagem
  // ====================================================
  "image#doguinho-bannerLaranja-vet":{
    "title": "Imagem cachorrinho banner laranja",
    "props": {
      "blockClass": "doguinho-bannerLaranja-vet",
      "alt": "cachorrinho",
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/0448046a-c47b-4621-b0ed-34073fb8ce9d___286ea753f9fb2e62491633cb320d2bbc.webp"
    }
  }
}
