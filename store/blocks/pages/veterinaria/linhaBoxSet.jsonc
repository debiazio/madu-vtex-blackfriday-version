{
  "responsive-layout.desktop#linhaBoxSet-vet":{
    "children": [
      "flex-layout.row#desktop-linhaBoxSet-vet"
    ]
  },
  "flex-layout.row#desktop-linhaBoxSet-vet": {
    "title": "linhaBoxSet",
    "props": {
      "blockClass": "linhaTwo-vet",
      "fullWidth": true,
      "preventHorizontalStretch": true
    },
    "children": [
      "flex-layout.row#textos-linhaBoxSet-vet",
      "responsive-layout.desktop#produtos-linhaBoxSet-vet",
      "responsive-layout.mobile#produtos-linhaBoxSet-vet"
    ]
  },
  "responsive-layout.mobile#linhaBoxSet-vet":{
    "children": [
      "flex-layout.row#linhaBoxSet-vet"
    ]
  },
  "flex-layout.row#linhaBoxSet-vet": {
    "title": "linhaBoxSet",
    "props": {
      "blockClass": "linhaTwo-vet",
      "fullWidth": true
    },
    "children": [
      "flex-layout.row#textos-linhaBoxSet-vet",
      "responsive-layout.desktop#produtos-linhaBoxSet-vet",
      "responsive-layout.mobile#produtos-linhaBoxSet-vet"

    ]
  },
  "flex-layout.row#textos-linhaBoxSet-vet": {
    "title": "Linha textos linhaBoxSet",
    "props": {
      "blockClass": "linha-textos-linhaTwo-vet",
      "preventHorizontalStretch": true,
      "colSizing": "auto"
    },
    "children": [
      "flex-layout.row#linha-linhaBoxSet-vet",
      "rich-text#subtitulo-linhaBoxSet-vet"
    ]
  },
  "flex-layout.row#linha-linhaBoxSet-vet": {
    "title": "Texto linhaBoxSet",
    "props": {
      "blockClass": "linha-titulo-linhaExpress-vet",
      "preventHorizontalStretch": true,
      "colSizing": "auto"
    },
    "children": [
      "rich-text#linhas",
      "image#tag-box-vet",
      "rich-text#mais",
      "image#tag-set-vet"
    ]
  },
  "rich-text#linhas":{
    "props": {
      "text": "Linhas",
      "blockClass": "linha"
    },
    "title": "Linha"
  },
  "rich-text#mais":{
    "props": {
      "text": "+",
      "blockClass": "linha"
    },
    "title": "+"
  },
  "image#tag-box-vet": {
    "title": "Tag box",
    "props": {
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/164f8e36-9a15-41ea-bae2-9f956d2154e5___b4b4de6bf3dc57a62f7a89326ea71ad3.svg",
      "blockClass": "image-tag-vet"
    }
  },
  "image#tag-set-vet": {
    "title": "Tag box",
    "props": {
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/238e28cb-39b6-419b-8d9d-6f9f71be7070___2bee03d3a8a6f6b4b1bd1d974c5cba50.svg",
      "blockClass": "image-tag-vet"
    }
  },
  "rich-text#subtitulo-linhaBoxSet-vet": {
    "title": "subtitulo-linhatwo-vet",
    "props": {
      "text": "Cada projeto possui uma realidade diferente. Por isso criamos maletas e organizadores que atendem desde clínicas compactas até grandes hospitais veterinários.",
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "blockClass": "subtitulo-linhatwo-vet"
    }
  },
  // ====================
  //  produtos
  // ====================
  "responsive-layout.desktop#produtos-linhaBoxSet-vet":{
    "children": [
      "flex-layout.row#produtos-linhaBoxSet-vet"
    ]
  },
