    "props": {
      "blockClass": "linha-produtos-linhaTwo-vet"
    },
    "children": [
      "flex-layout.col#coluna1Produto-linhaBoxSet-vet",
      "flex-layout.col#coluna2Produto-linhaBoxSet-vet",
