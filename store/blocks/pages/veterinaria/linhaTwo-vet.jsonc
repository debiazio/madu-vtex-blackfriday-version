  "rich-text#subtitulo-linhaTwo-vet": {
    "title": "subtitulo-linhatwo-vet",
    "props": {
      "text": "A Linha TWO reúne carrinhos modulares com diferentes configurações de gavetas, nichos, bins e acessórios para organizar medicamentos, insumos e materiais próximos ao ponto de uso.",
