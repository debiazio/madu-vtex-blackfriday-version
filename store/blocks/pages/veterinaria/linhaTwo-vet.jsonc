  //  ==================
  //  produtos mobiel
  "responsive-layout.mobile#produtos-linhaTwo-vet":{
    "children": [
      "flex-layout.row#slider-produtos-linhaTwo-vet"
    ]
  },
  "flex-layout.row#slider-produtos-linhaTwo-vet": {
    "title": "linha-slider-produtos-linhaTwo-vet",
    "props": {
      "blockClass": "linha-slider-produtos-linhaExpress-vet",
      "fullWidth": true
    },
    "children": [
      "slider-layout#slider-produtos-mobile-linhaTwo-vet"
    ]
  },
  "slider-layout#slider-produtos-mobile-linhaTwo-vet": {
    "title": "slider-produtos-mobile",
    "props": {
      "itemsPerPage": {
        "desktop": 0,
        "tablet": 0,
        "phone": 2

      },
      "infinite": true,
      "showNavigationArrows": "never",
      "showPaginationDots": "never",
      "blockClass": "slider-produtos-mobileVet"
    },
    "children": [
      "flex-layout.col#coluna1Produto-linhaTwo-vet",
      "flex-layout.col#coluna2Produto-linhaTwo-vet",
      "flex-layout.col#coluna3Produto-linhaTwo-vet",
      "flex-layout.col#coluna1Produto-linhaTwo-vet",
      "flex-layout.col#coluna2Produto-linhaTwo-vet",
