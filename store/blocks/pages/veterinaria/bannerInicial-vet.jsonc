{
  "flex-layout.row#primeiraLinha-vet": {
    "props": {
      "blockClass": "primeiraLinha-vet",
      "colSizing": "auto",
      "fullWidth": true
    },
    "children": [
      "flex-layout.row#linhaTextos-primeiraLinha-vet",
      "flex-layout.row#linhaImagem-primeiraLinha-vet"
    ],
    "title": "Banner incial"
  },
  "flex-layout.row#linhaTextos-primeiraLinha-vet": {
    "props": {
      "blockClass": "linhaTextos-primeiraLinha-vet",
      "colSizing": "auto"
    },
    "children": [
      "image#img-banner-inicial-vet",
      "rich-text#titulo-vet",
      "rich-text#subtitulo-vet",
      "link#solicitarCotacao-vet"
    ]
  },
  "image#img-banner-inicial-vet": {
    "props": {
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/d7ca8026-603d-4b09-aa97-ba8c539b751e___59642f20662c55a47049251d5d57b31b.webp",
      "alt": "Imagem madupet",
      "blockClass": "madupet-img"
    },
    "title": "Imagem madupet"
  },
  "rich-text#titulo-vet": {
    "props": {
      "blockClass": "titulo-vet",
      "text": "# Móveis que acompanham \n # a **rotina veterinária**"
    },
    "title": "Título"
  },
  "rich-text#subtitulo-vet": {
    "props": {
      "blockClass": "subtitulo-vet",
      "text": "Móveis para clínicas, hospitais e laboratórios veterinários que buscam organização, mobilidade e eficiência."
    },
    "title": "Subtítulo"
  },
  "link#solicitarCotacao-vet": {
    "props": {
      "href": "#linhaone",
      "label": "CONHEÇA OS PRODUTOS",
      "blockClass": "link-solicitarCotacao-vet"
    },
    "title": "Link soluções"
  },
  "flex-layout.row#linhaImagem-primeiraLinha-vet": {
    "props": {
      "blockClass": "linhaImagem-primeiraLinha-vet",
      "colSizing": "auto"
    },
    "children": [
      "image#imagem-vet"
    ],
    "title": "Linha Imagem lp vet"
  },
  "image#imagem-vet": {
    "props": {
      "src": "https://madumfm2.vtexassets.com/assets/vtex.file-manager-graphql/images/8ea3b034-68e2-4b6b-829b-73b2ff7ea6eb___ac64570df5f5e35cee0b63065d73c963.webp",
      "alt": "imagem madu veterinaria",
      "blockClass": "imagem-banner-inicial-vet"
    },
    "title": "Imagem banner inicial"
  }
}
